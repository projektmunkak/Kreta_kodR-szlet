class Program
{
    static void Main()
    {
        IskolaRendszer rendszer = new IskolaRendszer();

        // Teszt felhasználók
        var diak = new Diak("Kiss Anna", "anna", "1234");
        var tanar = new Tanar("Nagy Péter", "peter", "abcd");

        rendszer.Regisztral(diak);
        rendszer.Regisztral(tanar);

        rendszer.Betoltes();

        while (true)
