            Console.Clear();
            Console.WriteLine("=== ISKOLA RENDSZER ===");
            Console.Write("Felhasználónév: ");
            string fn = Console.ReadLine();
            Console.Write("Jelszó: ");
            string pw = Console.ReadLine();

            var felh = rendszer.Login(fn, pw);
            if (felh != null)
            {
                if (felh is Diak d)
                    d.Menu(rendszer);
                else if (felh is Tanar t)
                    t.Menu(rendszer);
            }
            else
            {
                Console.WriteLine("Hibás belépés!");
                Console.ReadKey();
            }
        }
    }
}
        
