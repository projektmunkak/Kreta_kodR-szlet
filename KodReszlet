using System;

public class Jegy
{
    public string Tantargy { get; private set; }
    public int Ertek { get; private set; }
    public DateTime Datum { get; private set; }

    public Jegy(string tantargy, int ertek)
    {
        Tantargy = tantargy;
        Ertek = ertek;
        Datum = DateTime.Now;
    }

    public override string ToString()
    {
        return $"{Tantargy}: {Ertek} ({Datum.ToShortDateString()})";
    }
}







